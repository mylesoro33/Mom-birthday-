# Postgres connection string (Neon via the Vercel Marketplace sets this for you)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Public URL of the app, no trailing slash (used for the OAuth redirect)
APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this Google account may sign in. Strongly recommended.
ALLOWED_EMAIL=you@gmail.com

# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Random string for signing session cookies: openssl rand -base64 32
SESSION_SECRET=

# Random string the cron caller must send as "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron sends this header automatically when the variable is set.
CRON_SECRET=
